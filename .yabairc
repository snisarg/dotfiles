#!/usr/bin/env sh

# Yabai is used for app-to-Space routing, not automatic tiling.
# Moving windows to existing Spaces works with SIP fully enabled.
yabai -m config layout float

# Select a machine profile locally. YABAI_PROFILE can temporarily override the
# selector without changing the tracked config.
profile_file="$HOME/.config/yabai/profile"
yabai_profile="${YABAI_PROFILE:-}"
if [ -z "$yabai_profile" ] && [ -r "$profile_file" ]; then
    IFS= read -r yabai_profile < "$profile_file"
fi

if [ -z "$yabai_profile" ]; then
    echo "yabai: set a machine profile in $profile_file" >&2
    exit 1
fi

# Space labels are Yabai runtime state, so rebuild them on every launch. Each
# machine profile maps shared logical labels to that laptop's macOS Spaces.
space_inventory="$(yabai -m query --spaces)" || exit 1

label_space_by_id() {
    label="$1"
    id="$2"
    index="$(printf '%s\n' "$space_inventory" | jq -er --argjson id "$id" \
        '.[] | select(.id == $id) | .index')" || return 1
    yabai -m space "$index" --label "$label"
}

label_space_by_uuid() {
    label="$1"
    uuid="$2"
    index="$(printf '%s\n' "$space_inventory" | jq -er --arg uuid "$uuid" \
        '.[] | select(.uuid == $uuid) | .index')" || return 1
    yabai -m space "$index" --label "$label"
}

# Mail exposes its mailbox/list windows as "message viewers" through its
# AppleScript API. Detached message windows have the same accessibility role,
# so window title or role matching alone cannot reliably distinguish them.
route_existing_mail_viewers() {
    pgrep -x Mail >/dev/null 2>&1 || return 0

    osascript -e 'tell application "Mail" to get id of window of every message viewer' 2>/dev/null |
        tr ',' '\n' |
        while IFS= read -r window_id; do
            window_id="$(printf '%s' "$window_id" | tr -d '[:space:]')"
            case "$window_id" in
                ''|*[!0-9]*) continue ;;
            esac
            yabai -m window "$window_id" --space mail
        done
}

routing_ready=true
profile_config="$HOME/.config/yabai/profiles/$yabai_profile.sh"
if [ ! -r "$profile_config" ]; then
    echo "yabai: profile config not found: $profile_config" >&2
    exit 1
fi

# Each profile provides bind_profile_spaces and may set routing_ready=false if
# one of that laptop's configured Spaces cannot be found.
# shellcheck disable=SC1090
. "$profile_config"
if command -v bind_profile_spaces >/dev/null 2>&1; then
    bind_profile_spaces
else
    echo "yabai: $profile_config must define bind_profile_spaces" >&2
    routing_ready=false
fi

if "$routing_ready"; then
    rule_labels="route-trading route-discord route-work-comms route-coding route-obsidian-work route-obsidian-bots route-chrome-2 route-chrome-3 route-chrome-4 route-chrome-5 route-chrome-6 route-chrome-8 route-chrome-10 route-chatgpt route-github-desktop route-opal route-planning route-personal-comms"

    # Avoid duplicate rules when the config is reloaded without a daemon restart.
    # route-mail is the old broad rule that also captured detached Mail windows.
    for rule_label in $rule_labels route-mail; do
        yabai -m rule --remove "$rule_label" 2>/dev/null || true
    done

    yabai -m rule --add label=route-trading \
        app='^TradingView$' space=trading
    yabai -m rule --add label=route-discord \
        app='^Discord$' space=trading
    yabai -m rule --add label=route-work-comms \
        app='^(Slack|Morpheus)$' space=work-comms
    yabai -m rule --add label=route-coding \
        app='^PyCharm$' space=coding
    yabai -m rule --add label=route-obsidian-work \
        app='^Obsidian$' title='^.* - work - Obsidian( |$)' space=work-comms
    yabai -m rule --add label=route-obsidian-bots \
        app='^Obsidian$' title='^.* - bots - Obsidian( |$)' space=planning
    yabai -m rule --add label=route-chrome-2 \
        app='^Google Chrome$' title='^2($| - )' space=work-comms
    yabai -m rule --add label=route-chrome-3 \
        app='^Google Chrome$' title='^3($| - )' space=coding
    yabai -m rule --add label=route-chrome-4 \
        app='^Google Chrome$' title='^4($| - )' space=chrome-4
    yabai -m rule --add label=route-chrome-5 \
        app='^Google Chrome$' title='^5($| - )' space=chrome-5
    yabai -m rule --add label=route-chrome-6 \
        app='^Google Chrome$' title='^6($| - )' space=chrome-6
    yabai -m rule --add label=route-chrome-8 \
        app='^Google Chrome$' title='^8($| - )' space=chrome-8
    yabai -m rule --add label=route-chrome-10 \
        app='^Google Chrome$' title='^10($| - )' space=chrome-10
    yabai -m rule --add label=route-chatgpt \
        app='^ChatGPT$' space=chatgpt
    yabai -m rule --add label=route-github-desktop \
        app='^GitHub Desktop$' space=chatgpt
    yabai -m rule --add label=route-opal \
        app='^Opal$' space=mail
    yabai -m rule --add label=route-planning \
        app='^(Calendar|Sheets|Google Keep|Toggl Track)$' space=planning
    yabai -m rule --add label=route-personal-comms \
        app='^.*WhatsApp$' space=personal-comms

    # Catch windows restored before Yabai finished loading at login. Future
    # windows are handled automatically as they are created.
    for rule_label in $rule_labels; do
        yabai -m rule --apply "$rule_label"
    done

    # Restore only Mail's main mailbox/list viewers. Individual message windows
    # are intentionally unmanaged and remain on the Space where they opened.
    route_existing_mail_viewers

    yabai -m signal --remove route-mail-viewers 2>/dev/null || true
    yabai -m signal --add label=route-mail-viewers \
        event=window_created app='^Mail$' \
        action='attempt=0; while [ "$attempt" -lt 3 ]; do viewer_ids="$(osascript -e "tell application \"Mail\" to get id of window of every message viewer" 2>/dev/null)"; if printf "%s\n" "$viewer_ids" | tr "," "\n" | grep -Eq "^[[:space:]]*$YABAI_WINDOW_ID[[:space:]]*$"; then yabai -m window "$YABAI_WINDOW_ID" --space mail; exit 0; fi; attempt=$((attempt + 1)); sleep 1; done'

    # Chrome and Obsidian can create a window before restoring its stable name.
    # Retry only their own rules once after window creation; title changes such
    # as switching tabs or notes must not reapply unrelated app assignments.
    yabai -m signal --remove route-named-chrome 2>/dev/null || true
    yabai -m signal --add label=route-named-chrome \
        event=window_created app='^Google Chrome$' \
        action='sleep 2; yabai -m rule --apply route-chrome-2; yabai -m rule --apply route-chrome-3; yabai -m rule --apply route-chrome-4; yabai -m rule --apply route-chrome-5; yabai -m rule --apply route-chrome-6; yabai -m rule --apply route-chrome-8; yabai -m rule --apply route-chrome-10'

    yabai -m signal --remove route-obsidian-vaults 2>/dev/null || true
    yabai -m signal --add label=route-obsidian-vaults \
        event=window_created app='^Obsidian$' \
        action='sleep 2; yabai -m rule --apply route-obsidian-work; yabai -m rule --apply route-obsidian-bots'
else
    echo "yabai: one or more configured Spaces could not be found; routing skipped" >&2
fi
