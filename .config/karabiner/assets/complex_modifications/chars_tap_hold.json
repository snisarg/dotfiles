// ┌──────────────────────────────────────────────┐
// │ Key-index  (reserved in this rule-set)       │
// ├──────────────────────────────────────────────┤
// │ N / M / U / I / O / P                        │
// │                                              │
// │ tap  → plain letter                          │
// │ hold → [ / ] / { / } / = / +                 │
// │ Matches with other modifiers held, so e.g.   │
// │ cmd+hold-n → cmd+[, cmd+hold-m → cmd+]       │
// └──────────────────────────────────────────────┘

{
  "title": "Char Tap-Hold (N/M/U/I/O/P)",
  "rules": [
    {
      "description": "Tap for letter, hold for symbol. N=[, M=], U={, I=}, O==, P=+. Works alongside other held modifiers, e.g. cmd+hold-m = cmd+].",
      "manipulators": [

        { "from": { "key_code": "n", "modifiers": { "optional": ["any"] } }, "to_delayed_action": { "to_if_canceled": [ { "key_code": "n" } ], "to_if_invoked": [ { "key_code": "vk_none" } ] }, "to_if_alone": [ { "halt": true, "key_code": "n" } ], "to_if_held_down": [ { "halt": true, "key_code": "open_bracket" } ], "type": "basic" },
        { "from": { "key_code": "m", "modifiers": { "optional": ["any"] } }, "to_delayed_action": { "to_if_canceled": [ { "key_code": "m" } ], "to_if_invoked": [ { "key_code": "vk_none" } ] }, "to_if_alone": [ { "halt": true, "key_code": "m" } ], "to_if_held_down": [ { "halt": true, "key_code": "close_bracket" } ], "type": "basic" },
        { "from": { "key_code": "u", "modifiers": { "optional": ["any"] } }, "to_delayed_action": { "to_if_canceled": [ { "key_code": "u" } ], "to_if_invoked": [ { "key_code": "vk_none" } ] }, "to_if_alone": [ { "halt": true, "key_code": "u" } ], "to_if_held_down": [ { "halt": true, "key_code": "open_bracket", "modifiers": [ "right_shift" ] } ], "type": "basic" },
        { "from": { "key_code": "i", "modifiers": { "optional": ["any"] } }, "to_delayed_action": { "to_if_canceled": [ { "key_code": "i" } ], "to_if_invoked": [ { "key_code": "vk_none" } ] }, "to_if_alone": [ { "halt": true, "key_code": "i" } ], "to_if_held_down": [ { "halt": true, "key_code": "close_bracket", "modifiers": [ "right_shift" ] } ], "type": "basic" },
        { "from": { "key_code": "o", "modifiers": { "optional": ["any"] } }, "to_delayed_action": { "to_if_canceled": [ { "key_code": "o" } ], "to_if_invoked": [ { "key_code": "vk_none" } ] }, "to_if_alone": [ { "halt": true, "key_code": "o" } ], "to_if_held_down": [ { "halt": true, "key_code": "equal_sign" } ], "type": "basic" },
        { "from": { "key_code": "p", "modifiers": { "optional": ["any"] } }, "to_delayed_action": { "to_if_canceled": [ { "key_code": "p" } ], "to_if_invoked": [ { "key_code": "vk_none" } ] }, "to_if_alone": [ { "halt": true, "key_code": "p" } ], "to_if_held_down": [ { "halt": true, "key_code": "equal_sign", "modifiers": [ "right_shift" ] } ], "type": "basic" }

      ] /* manipulators */
    }
  ]
}
